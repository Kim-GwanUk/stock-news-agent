# Copy to .env.local and fill in your own credentials. Never commit real keys.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KRX_API_KEY=
DART_API_KEY=
OPENAI_API_KEY=

# Optional local settings. Docker Compose overrides container service addresses.
OPENAI_MODEL=gpt-4.1-mini
DART_RAG_ENABLED=1
QDRANT_URL=http://127.0.0.1:6333
